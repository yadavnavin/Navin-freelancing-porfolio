---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import {
  person,
  intro,
  projects,
  products,
  services,
  approach,
  technologies,
  contact,
} from "../data/site.mjs";
const featured = projects[0];
const mailto = `mailto:${person.email}?subject=${encodeURIComponent(contact.subject)}`;
---

<Layout>
  <section class="hero shell" aria-labelledby="intro-title">
    <div class="hero-copy">
      <h1 id="intro-title">
        {intro.title}
        <br />
        {intro.emphasis}
      </h1>
      <p class="hero-description">{intro.description}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#work">
          View my work
        </a>
        <a class="button button-secondary" href="#contact">
          Work with me
        </a>
      </div>
    </div>
    <aside class="hero-aside" aria-label="Experience and focus">
      <p class="experience-label">{person.experience}</p>
      <div class="aside-divider"></div>
      <p class="aside-stack">{intro.stack}</p>
      <p class="aside-note">{intro.note}</p>
    </aside>
  </section>

  <section
    id="work"
    class="section shell work-section"
    aria-labelledby="work-title"
  >
    <div class="section-heading">
      <h2 id="work-title">Selected engineering work.</h2>
      <p class="section-note">Professional work · Details anonymized</p>
    </div>
    <article class="featured-work">
      <div class="featured-copy">
        <h3>{featured.name}</h3>
        <p>{featured.summary}</p>
        <ul class="tech-list" aria-label="Technologies">
          {featured.technologies.slice(0, 3).map((technology) => (
            <li>{technology}</li>
          ))}
        </ul>
        <a class="text-link" href={`/work/${featured.slug}/`}>
          Explore the project
        </a>
      </div>
      <div class="engineering-notes">
        <p class="notes-heading">Product & contributions</p>
        {featured.topics.map((topic) => (
          <div class="focus-row">
            <span>{topic}</span>
          </div>
        ))}
      </div>
    </article>
    <div class="secondary-work">
      {projects.slice(1).map((project) => (
        <article class="work-row">
          <div>
            <h3>
              <a href={`/work/${project.slug}/`}>{project.name}</a>
            </h3>
            <p>{project.summary}</p>
            <p class="project-topics">{project.topics.join(" / ")}</p>
          </div>
          <a
            class="text-link"
            href={`/work/${project.slug}/`}
            aria-label={`Read overview: ${project.name}`}
          >
            Read overview
          </a>
        </article>
      ))}
    </div>
    <p class="confidentiality-note">
      Employer-owned work. These summaries describe what each product does and
      my contributions. Company names, internal architecture, and implementation
      details remain private.
    </p>
  </section>

  <section id="products" class="section shell" aria-label="Public products">
    <SectionHeading
      title="Independent products."
      note="My own products, from interface to implementation."
    />
    <div class="products-grid">
      {products.map((product) => (
        <article class="product">
          <div class="product-top">
            <h3>
              {product.name}
              <span>.</span>
            </h3>
            <span class="product-status">{product.label}</span>
          </div>
          <h4>{product.tagline}</h4>
          <p>{product.description}</p>
          <p class="product-details">{product.details}</p>
          <div class="product-bottom">
            <p class="product-stack">{product.stack}</p>
            {product.url ? (
              <a class="text-link" href={product.url}>
                Visit {product.name}
              </a>
            ) : (
              person.email && (
                <a
                  class="text-link"
                  href={`mailto:${person.email}?subject=${encodeURIComponent(`Tell me about ${product.name}`)}`}
                >
                  Ask about {product.name}
                </a>
              )
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="services" class="services-band" aria-label="Services">
    <div class="shell section">
      <SectionHeading
        title="What I can help with."
        note="For founders, agencies, and teams working with .NET."
      />
      <div class="services-grid">
        {services.map((service) => (
          <article class="service">
            <div>
              <h3>{service.title}</h3>
              <p>{service.text}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="services-end">
        <p>Have an existing application? That’s a good place to start.</p>
        <a class="text-link" href="#contact">
          Discuss your project
        </a>
      </div>
    </div>
  </section>

  <section
    id="about"
    class="section shell about-section"
    aria-label="About and engineering approach"
  >
    <div class="about-copy">
      <h2>{approach.title}</h2>
      {approach.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    <div class="tooling">
      <h3>Tools I work with</h3>
      <dl>
        {technologies.map((group) => (
          <div>
            <dt>{group.title}</dt>
            <dd>{group.items}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="contact" class="contact-band" aria-labelledby="contact-title">
    <div class="shell contact-inner">
      <div>
        <h2 id="contact-title">
          {contact.title.split("\n").map((line) => (
            <span>
              {line}
              <br />
            </span>
          ))}
        </h2>
      </div>
      <div class="contact-copy">
        <p>{contact.description}</p>
        {person.email ? (
          <>
            <a class="contact-email" href={mailto}>
              {person.email}
            </a>
            <p class="contact-hint">
              Email me with a little context to get the conversation started.
            </p>
          </>
        ) : (
          <p>{contact.unavailable}</p>
        )}
      </div>
    </div>
  </section>
</Layout>
